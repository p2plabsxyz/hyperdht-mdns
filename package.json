{
  "name": "@p2plabs/hyperdht-mdns",
  "version": "1.3.0",
  "description": "Offline LAN peer discovery for Hyperswarm using mDNS and an isolated HyperDHT",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "examples/three-box-chat.js"
  ],
  "bin": {
    "hyperdht-mdns-chat": "examples/three-box-chat.js"
  },
  "scripts": {
    "demo:lan": "node examples/three-box-chat.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:mdns": "node test-utils/bonjour-smoke.js",
    "lint": "standard",
    "benchmark": "node test/benchmark.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "hyperswarm",
    "hyperdht",
    "mdns",
    "lan",
    "offline",
    "p2p"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2plabsxyz/hyperdht-mdns.git"
  },
  "bugs": {
    "url": "https://github.com/p2plabsxyz/hyperdht-mdns/issues"
  },
  "homepage": "https://github.com/p2plabsxyz/hyperdht-mdns#readme",
  "author": "P2P Labs <contact@p2plabs.xyz>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "compact-encoding": "^3.3.0",
    "hyperdht": "^6.26.0",
    "hyperswarm": "^4.15.0",
    "protomux": "^3.11.0"
  },
  "devDependencies": {
    "corestore": "^7.12.0",
    "hyper-sdk": "^6.2.2",
    "standard": "^17.1.2"
  }
}
